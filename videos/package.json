{
  "name": "videos-curso",
  "private": true,
  "type": "module",
  "description": "Videos estilo reel de las lecciones (HyperFrames: HTML a MP4).",
  "scripts": {
    "ver": "HYPERFRAMES_NO_TELEMETRY=1 DO_NOT_TRACK=1 HYPERFRAMES_SKIP_SKILLS=1 HYPERFRAMES_FFMPEG_PATH=$PWD/node_modules/ffmpeg-static/ffmpeg HYPERFRAMES_FFPROBE_PATH=$PWD/node_modules/@ffprobe-installer/darwin-arm64/ffprobe hyperframes preview",
    "revisar": "HYPERFRAMES_NO_TELEMETRY=1 DO_NOT_TRACK=1 HYPERFRAMES_SKIP_SKILLS=1 HYPERFRAMES_FFMPEG_PATH=$PWD/node_modules/ffmpeg-static/ffmpeg HYPERFRAMES_FFPROBE_PATH=$PWD/node_modules/@ffprobe-installer/darwin-arm64/ffprobe hyperframes check",
    "fotos": "HYPERFRAMES_NO_TELEMETRY=1 DO_NOT_TRACK=1 HYPERFRAMES_SKIP_SKILLS=1 HYPERFRAMES_FFMPEG_PATH=$PWD/node_modules/ffmpeg-static/ffmpeg HYPERFRAMES_FFPROBE_PATH=$PWD/node_modules/@ffprobe-installer/darwin-arm64/ffprobe hyperframes snapshot",
    "render": "HYPERFRAMES_NO_TELEMETRY=1 DO_NOT_TRACK=1 HYPERFRAMES_SKIP_SKILLS=1 HYPERFRAMES_FFMPEG_PATH=$PWD/node_modules/ffmpeg-static/ffmpeg HYPERFRAMES_FFPROBE_PATH=$PWD/node_modules/@ffprobe-installer/darwin-arm64/ffprobe hyperframes render -f 30 --crf 26 -w 2 --keyframe-interval 2"
  },
  "devDependencies": {
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "ffmpeg-static": "^5.3.0",
    "hyperframes": "^0.9.69"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "ffmpeg-static@5.3.0": true,
    "@ffprobe-installer/darwin-arm64@5.0.1": true
  }
}