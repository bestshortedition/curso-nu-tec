---
/**
 * Tarjeta "Lo que has aprendido". Aparece (con JavaScript) cuando la persona ya contestó
 * la encuesta inicial y al menos una pregunta en una lección. Así, si se salió sin terminar,
 * al volver ve cuánto avanzó. Lleva a /resultados/.
 */
import Icono from './Icono.astro';
const base = import.meta.env.BASE_URL;
---

<a class="avance-apr" href={`${base}resultados/`} data-avance-apr hidden>
	<span class="aa-ico"><Icono nombre="chart-line-up" tamano={24} /></span>
	<span class="aa-txt">
		<span class="aa-etq">Lo que has aprendido</span>
		<span class="aa-num" data-aa-num></span>
		<span class="aa-sub" data-aa-sub></span>
	</span>
	<Icono nombre="arrow-right" tamano={20} class="aa-flecha" />
</a>

<script>
	import { resumir } from '../lib/aprendizaje';

	const pintar = () => {
		const r = resumir();
		document.querySelectorAll<HTMLElement>('[data-avance-apr]').forEach((el) => {
			if (!r.tieneEncuesta || r.vistos === 0) return;
			el.querySelector('[data-aa-num]')!.textContent = `Antes ${r.antesBienVistos} · Ahora ${r.ahoraBienVistos}`;
			el.querySelector('[data-aa-sub]')!.textContent =
				`Aciertos en ${r.vistos === 1 ? 'el tema que ya viste' : `los ${r.vistos} temas que ya viste`}. Ver tus resultados.`;
			el.hidden = false;
		});
	};
	pintar();
	document.addEventListener('diagnostico-listo', pintar);
</script>

<style>
	.avance-apr {
		display: grid;
		grid-template-columns: auto 1fr auto;
		align-items: center;
		gap: 0.875rem;
		padding: 1rem 1.125rem;
		border-radius: var(--radio);
		background: var(--morado-claro);
		color: var(--tinta);
		text-decoration: none;
		transition: box-shadow 0.15s;
	}
	.avance-apr[hidden] {
		display: none;
	}
	.avance-apr:hover {
		box-shadow: inset 0 0 0 2px var(--morado);
	}
	.aa-ico {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 3rem;
		height: 3rem;
		border-radius: 0.875rem;
		background: var(--morado);
		color: #fff;
	}
	.aa-txt {
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
	}
	.aa-etq {
		font-size: 0.8125rem;
		font-weight: 600;
		color: var(--morado-oscuro);
	}
	.aa-num {
		font-family: var(--f-titulo);
		font-size: 1.125rem;
		font-weight: 600;
		letter-spacing: -0.01em;
	}
	.aa-sub {
		font-size: 0.875rem;
		color: var(--tinta-2);
	}
	.avance-apr :global(.aa-flecha) {
		color: var(--morado);
	}
</style>
