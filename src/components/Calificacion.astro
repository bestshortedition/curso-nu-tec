---
/**
 * "¿Qué tanto te gustó?" de 1 a 5, al final de cada tema.
 * Se guarda solo en este navegador. Para medir el piloto, usen el formulario anónimo.
 */
interface Props {
	tema: string;
}
const { tema } = Astro.props;
---

<section class="calif not-content solo-js" data-calificacion={tema} aria-labelledby="calif-t">
	<h2 id="calif-t">¿Qué tanto te gustó este tema?</h2>
	<p class="ayuda">1 = nada · 5 = mucho</p>
	<div class="botones" role="group" aria-labelledby="calif-t">
		{[1, 2, 3, 4, 5].map((n) => <button type="button" data-n={n} aria-pressed="false">{n}</button>)}
	</div>
	<p class="gracias" role="status" aria-live="polite"></p>
</section>

<script>
	document.querySelectorAll<HTMLElement>('[data-calificacion]').forEach((caja) => {
		const tema = caja.dataset.calificacion!;
		const gracias = caja.querySelector<HTMLElement>('.gracias')!;
		const marcar = (n: string) => {
			caja.querySelectorAll('button').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.n === n)));
			gracias.textContent = '¡Gracias por tu respuesta!';
		};
		try {
			const r = JSON.parse(localStorage.getItem('bytes-calificacion') || '{}');
			if (r[tema]) marcar(String(r[tema]));
		} catch {}
		caja.addEventListener('click', (e) => {
			const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-n]');
			if (!b) return;
			marcar(b.dataset.n!);
			try {
				const r = JSON.parse(localStorage.getItem('bytes-calificacion') || '{}');
				r[tema] = Number(b.dataset.n);
				localStorage.setItem('bytes-calificacion', JSON.stringify(r));
			} catch {}
		});
	});
</script>

<style>
	.calif {
		margin: 2rem 0;
		padding: 1.25rem;
		border-radius: 1.25rem;
		background: var(--nu-lila);
	}
	:global(.js) .calif.solo-js {
		display: block;
	}
	h2 {
		margin: 0;
		font-size: 1.25rem;
		color: var(--nu-texto);
	}
	.ayuda {
		margin: 0.25rem 0 0.75rem;
		color: var(--nu-gris);
	}
	.botones {
		display: grid;
		grid-template-columns: repeat(5, 1fr);
		gap: 0.5rem;
		max-width: 22rem;
	}
	button {
		min-height: 3rem;
		font: inherit;
		font-size: 1.125rem;
		font-weight: 700;
		color: var(--nu-morado);
		background: #ffffff;
		border: 2px solid var(--nu-lila-borde);
		border-radius: 0.875rem;
		cursor: pointer;
	}
	button[aria-pressed='true'] {
		background: var(--nu-morado);
		border-color: var(--nu-morado);
		color: #ffffff;
	}
	.gracias {
		margin: 0.75rem 0 0;
		font-weight: 600;
		min-height: 1.5em;
	}
</style>
