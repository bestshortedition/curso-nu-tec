---
/** Los 5 temas en la portada. Solo los activos tienen enlace. */
import Icono from './Icono.astro';
import { temas } from '../lib/temas';
const base = import.meta.env.BASE_URL;
const [primero, ...resto] = temas;
---

<div class="temas not-content">
	<a class="destacado" href={`${base}${primero.clave}/`}>
		<span class="icono-caja"><Icono nombre={primero.icono} tamano={32} /></span>
		<span class="n">Tema {primero.numero} · Empieza aquí</span>
		<span class="t">{primero.titulo}</span>
		<span class="r">{primero.resumen}</span>
		<span class="ir">Empezar <Icono nombre="arrow-right" tamano={20} /></span>
	</a>

	<h2 class="proximos">Lo que viene</h2>
	<ul>
		{resto.map((t) => (
			<li class:list={{ inactivo: !t.activo }}>
				{t.activo ? (
					<a href={`${base}${t.clave}/`}><Icono nombre={t.icono} /> <span>{t.numero}. {t.titulo}</span></a>
				) : (
					<span class="fila"><Icono nombre={t.icono} /> <span>{t.numero}. {t.titulo}</span> <em>Próximamente</em></span>
				)}
			</li>
		))}
	</ul>
</div>

<style>
	.temas {
		margin-top: 2rem;
	}
	.destacado {
		display: grid;
		gap: 0.4rem;
		padding: 1.5rem;
		border-radius: 1.5rem;
		background: var(--nu-morado);
		color: #ffffff;
		text-decoration: none;
	}
	.destacado:hover {
		background: var(--nu-morado-oscuro);
	}
	.icono-caja {
		display: inline-flex;
		width: 3.5rem;
		height: 3.5rem;
		align-items: center;
		justify-content: center;
		border-radius: 1rem;
		background: rgba(255, 255, 255, 0.14);
		margin-bottom: 0.5rem;
	}
	.n {
		font-size: 0.875rem;
		font-weight: 600;
		color: var(--nu-lila);
	}
	.t {
		font-size: 1.5rem;
		font-weight: 700;
		line-height: 1.2;
	}
	.r {
		color: var(--nu-lila);
	}
	.ir {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		margin-top: 0.75rem;
		font-weight: 700;
	}
	.proximos {
		margin: 2.5rem 0 0.5rem;
		font-size: 1.125rem;
		color: var(--nu-texto);
	}
	ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	li {
		border-bottom: 1px solid var(--nu-linea);
	}
	.fila,
	li a {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		min-height: 3.5rem;
		color: var(--nu-texto);
		font-weight: 600;
	}
	.inactivo .fila {
		color: var(--nu-gris);
	}
	em {
		margin-left: auto;
		font-style: normal;
		font-size: 0.8125rem;
		font-weight: 600;
		padding: 0.2rem 0.6rem;
		border-radius: 999px;
		background: var(--nu-lila);
		color: var(--nu-morado-oscuro);
		white-space: nowrap;
	}
</style>
