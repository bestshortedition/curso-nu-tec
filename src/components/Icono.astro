	'lock-fill': i_lockFill,
	'check-circle-fill': i_checkCircleFill,
	'play-fill': i_playFill,
} as const;

export type NombreIcono = keyof typeof iconos;

interface Props {
	nombre: NombreIcono;
	tamano?: number | string;
	class?: string;
}
const { nombre, tamano = 24, class: clase } = Astro.props;
const svg = iconos[nombre].replace(
	'<svg',
	`<svg width="${tamano}" height="${tamano}" aria-hidden="true" focusable="false"`,
);
---

<span class:list={['icono', clase]} set:html={svg} />

<style>
	.icono {
		display: inline-flex;
		flex: none;
		line-height: 0;
	}
</style>
