---
/**
 * Recuadro chico para un dato técnico o una regla oficial, con su fuente.
 *
 *   <Nota titulo="La regla de Banxico" fuente="Banxico, Circular 34/2010">Texto.</Nota>
 */
import Icono, { type NombreIcono } from './Icono.astro';

interface Props {
	titulo: string;
	fuente?: string;
	icono?: NombreIcono;
}
const { titulo, fuente, icono = 'info' } = Astro.props;
---

<aside class="nota-caja">
	<p class="tit"><Icono nombre={icono} tamano={20} /> {titulo}</p>
	<div class="cuerpo"><slot /></div>
	{fuente && <p class="fuente">Fuente: {fuente}</p>}
</aside>

<style>
	.nota-caja {
		margin-top: 1.25rem;
		padding: 1rem 1.125rem;
		border-radius: var(--radio);
		box-shadow: inset 0 0 0 1px var(--linea);
	}
	.tit {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-family: var(--f-titulo);
		font-weight: 600;
		font-size: 0.9375rem !important;
		color: var(--morado-oscuro) !important;
	}
	.cuerpo :global(p) {
		margin-top: 0.4rem;
		font-size: 1rem !important;
		line-height: 1.5 !important;
	}
	.fuente {
		margin-top: 0.5rem;
		font-size: 0.8125rem !important;
		color: var(--gris) !important;
	}
</style>
