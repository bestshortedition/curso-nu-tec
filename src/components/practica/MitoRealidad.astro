---
/**
 * Juego "¿Mito o realidad?" de la página Practica. Usa el componente <Clasifica>.
 * Las frases viven en src/data/practica.ts.
 */
import Clasifica from '../Clasifica.astro';
import { mitoRealidad } from '../../data/practica';
---

<Clasifica
	opciones={[
		{ texto: 'Mito', icono: 'x-circle' },
		{ texto: 'Realidad', icono: 'check-circle' },
	]}
	items={mitoRealidad.map((a) => ({ frase: a.frase, correcta: a.esMito ? 0 : 1, explicacion: a.explicacion, fuente: a.fuente }))}
/>
