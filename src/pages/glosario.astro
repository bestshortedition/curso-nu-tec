---
/**
 * Glosario: todas las palabras difíciles del curso, con definición y ejemplo.
 * Las palabras viven en src/data/glosario.ts. Con JavaScript se puede buscar.
 */
import Base from '../layouts/Base.astro';
import Icono from '../components/Icono.astro';
import Definicion from '../components/Definicion.astro';
import { glosario } from '../data/glosario';

const base = import.meta.env.BASE_URL;
const palabras = [...glosario].sort((a, b) => a.palabra.localeCompare(b.palabra, 'es'));
---

<Base titulo="Glosario" descripcion="Las palabras difíciles del dinero, explicadas en una frase y con un ejemplo.">
	<div class="contenedor">
		<nav class="migas" aria-label="Ruta">
			<a href={`${base}ruta/`}><Icono nombre="arrow-left" tamano={18} /> Tu ruta</a>
		</nav>

		<header class="cabeza">
			<p class="sobretitulo"><Icono nombre="book-bookmark" tamano={18} /> Glosario</p>
			<h1>Las palabras difíciles, en <em>fácil.</em></h1>
			<p class="bajada">Cada palabra en una o dos frases, con un ejemplo de la vida diaria. También las ves dentro de las lecciones: toca una palabra subrayada.</p>
			<label class="buscar solo-js">
				<Icono nombre="magnifying-glass" tamano={20} />
				<span class="sr-only">Buscar una palabra</span>
				<input type="search" placeholder="Busca: corte, CAT, buró…" data-buscar autocomplete="off" />
			</label>
			<p class="sin-resultados" data-sin-resultados hidden>No encontramos esa palabra. Prueba con otra.</p>
		</header>

		<div class="lista">
			{palabras.map((p) => (
				<div class="item" data-texto={`${p.palabra} ${p.definicion}`.toLowerCase()}>
					<Definicion palabra={p} encabezado />
				</div>
			))}
		</div>
	</div>
</Base>

<script>
	const campo = document.querySelector<HTMLInputElement>('[data-buscar]')!;
	const items = [...document.querySelectorAll<HTMLElement>('.item')];
	const vacio = document.querySelector<HTMLElement>('[data-sin-resultados]')!;
	const sinAcentos = (t: string) => t.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
	campo.addEventListener('input', () => {
		const q = sinAcentos(campo.value.trim());
		let visibles = 0;
		items.forEach((it) => {
			const si = !q || sinAcentos(it.dataset.texto!).includes(q);
			it.hidden = !si;
			if (si) visibles++;
		});
		vacio.hidden = visibles > 0;
	});
</script>

<style>
	.migas {
		padding-top: 1.25rem;
	}
	.migas a {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		min-height: 2.75rem;
		color: var(--gris);
		text-decoration: none;
		font-size: 0.9375rem;
	}
	.cabeza {
		padding: 1rem 0 1.5rem;
	}
	.sobretitulo {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
	}
	h1 {
		margin-top: 0.75rem;
		font-size: clamp(2.125rem, 9vw, 3rem);
		letter-spacing: -0.045em;
		line-height: 1.02;
	}
	h1 em {
		font-family: var(--f-display);
		font-weight: 400;
		letter-spacing: -0.01em;
		color: var(--morado);
	}
	.bajada {
		margin-top: 1rem;
		font-size: 1.125rem;
		color: var(--tinta-2);
	}
	.buscar {
		display: flex;
		align-items: center;
		gap: 0.625rem;
		margin-top: 1.5rem;
		padding: 0 1rem;
		min-height: 3.25rem;
		border-radius: 999px;
		box-shadow: inset 0 0 0 1.5px var(--linea);
		color: var(--gris);
	}
	.buscar:focus-within {
		box-shadow: inset 0 0 0 2px var(--morado);
	}
	.buscar input {
		flex: 1;
		min-width: 0;
		border: 0;
		outline: 0;
		background: none;
		font: inherit;
		font-size: 1.0625rem;
		color: var(--tinta);
	}
	.sin-resultados {
		margin-top: 1rem;
		color: var(--gris);
	}
	.sin-resultados[hidden] {
		display: none;
	}
	.lista {
		display: grid;
		gap: 0.875rem;
		padding-bottom: 3rem;
	}
	.item {
		padding: 1.25rem;
		border-radius: var(--radio);
		box-shadow: inset 0 0 0 1px var(--linea);
		scroll-margin-top: calc(var(--alto-barra) + 1rem);
	}
	.item[hidden] {
		display: none;
	}
	.item:has(:target) {
		box-shadow: inset 0 0 0 2px var(--morado);
	}
</style>
