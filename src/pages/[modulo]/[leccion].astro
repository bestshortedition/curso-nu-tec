---
/**
 * Página de una lección. Se arma así:
 *   0. Animación del título (solo con JavaScript)
 *   1. La duda: tema, pregunta y cifra de las entrevistas  ← del frontmatter
 *   2. Las pantallas del texto, separadas por `---`        ← del .mdx
 *   3. Hoy + ¿Te sirvió? + botones + compartir              ← del frontmatter
 * Con JavaScript se ve una pantalla a la vez. Sin JavaScript, todo seguido.
 */
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icono from '../../components/Icono.astro';
import Definicion from '../../components/Definicion.astro';
import { temario, buscarLeccion } from '../../data/temario';
import { buscarPalabra } from '../../data/glosario';

export async function getStaticPaths() {
	const entradas = await getCollection('lecciones');
	const publicadas = new Set(entradas.map((e) => e.data.numero));
	const orden = temario.flatMap((m) => m.lecciones.filter((l) => publicadas.has(l.numero)).map((l) => l.numero));

	return entradas.map((entrada) => {
		const encontrada = buscarLeccion(entrada.data.numero);
		if (!encontrada) throw new Error(`La lección ${entrada.data.numero} no está en src/data/temario.ts`);
		const { modulo, leccion } = encontrada;
		const esperado = `${modulo.clave}/${leccion.slug}`;
		if (entrada.id !== esperado) {
			throw new Error(`El archivo de la lección ${leccion.numero} debe llamarse src/content/lecciones/${esperado}.mdx`);
		}
		const i = orden.indexOf(leccion.numero);
		const sig = orden[i + 1] ? buscarLeccion(orden[i + 1]) : undefined;
		return {
			params: { modulo: modulo.clave, leccion: leccion.slug },
			props: { entrada, siguiente: sig ? { ...sig.leccion, modulo: sig.modulo.clave } : undefined },
		};
	});
}

interface Props {
	entrada: CollectionEntry<'lecciones'>;
	siguiente?: { numero: string; slug: string; titulo: string; modulo: string };
}
const { entrada, siguiente } = Astro.props;
const { modulo, leccion } = buscarLeccion(entrada.data.numero)!;
const { Content } = await render(entrada);
const d = entrada.data;
const base = import.meta.env.BASE_URL;
const urlModulo = `${base}${modulo.clave}/`;
const urlPublica = new URL(Astro.url.pathname, Astro.site).href;
const whatsapp = `https://wa.me/?text=${encodeURIComponent(`${leccion.titulo}\n${d.descripcion}\n${urlPublica}`)}`;
// Imagen de vista previa (WhatsApp) de cada módulo, en public/og/.
const ogPorModulo: Record<string, string> = {
	'gastos-y-ahorro': 'ahorro',
	'primera-cuenta': 'primera-cuenta',
	'pagar-y-transferir': 'seguridad',
	credito: 'credito',
	'historial-y-rendimiento': 'general',
};
const og = ogPorModulo[modulo.clave] ?? 'general';
const otroModulo = siguiente && siguiente.modulo !== modulo.clave;
const palabras = d.palabras.map(buscarPalabra);
---

<Base titulo={leccion.titulo} descripcion={d.descripcion} og={og} sinEncabezado sinPie>
	<article class="leccion" data-leccion={d.numero}>
		<header class="barra-sup">
			<a class="cerrar" href={urlModulo} aria-label={`Salir al módulo ${modulo.numero}`}>
				<Icono nombre="x" tamano={22} />
			</a>
			<div class="pasos solo-js" data-pasos aria-hidden="true"></div>
			<span class="sin-js etiqueta">Módulo {modulo.numero}</span>
			{palabras.length > 0 ? (
				<button type="button" class="btn-palabras" popovertarget="palabras-leccion" aria-haspopup="dialog">
					<Icono nombre="book-bookmark" tamano={18} /> Palabras
				</button>
			) : (
				<span class="num cifra">{d.numero}</span>
			)}
		</header>

		{palabras.length > 0 && (
			<div popover id="palabras-leccion" class="hoja-def hoja-palabras" role="dialog" aria-labelledby="palabras-tit">
				<div class="hp-arriba">
					<p class="hp-tit" id="palabras-tit"><Icono nombre="book-bookmark" tamano={22} /> Palabras de esta lección</p>
					<button type="button" class="hp-cerrar" popovertarget="palabras-leccion" popovertargetaction="hide" aria-label="Cerrar">
						<Icono nombre="x" tamano={20} />
					</button>
				</div>
				<p class="hp-sub">Toca una para ver qué significa, con un ejemplo.</p>
				<div class="hp-lista">
					{palabras.map((p) => (
						<details class="hp-item">
							<summary>{p.palabra}<Icono nombre="arrow-down" tamano={18} /></summary>
							<div class="hp-def"><Definicion palabra={p} /></div>
						</details>
					))}
				</div>
				<a class="hp-todo" href={`${base}glosario/`}>Ver todo el glosario <Icono nombre="arrow-right" tamano={18} /></a>
			</div>
		)}

		<div class="portada-anim solo-js" data-portada aria-hidden="true">
			<div class="pa-dentro">
				<span class="pa-ico"><Icono nombre={leccion.icono} tamano={40} /></span>
				<p class="pa-mod">Módulo {modulo.numero} · Lección {d.numero}</p>
				<p class="pa-tit">
					{leccion.titulo.split(' ').map((palabra, i, todas) => (
						<><span class="pa-linea">
							<span class:list={['pa-pal', { 'pa-ital': i === todas.length - 1 }]} style={`--i:${i}`}>{palabra}</span>
						</span>{i < todas.length - 1 && ' '}</>
					))}
				</p>
			</div>
		</div>

		<div class="pantallas contenedor" data-contenedor>
			<section class="pantalla pantalla--duda" data-pantalla>
				<div class="cabeza-leccion" data-cabeza>
					<p class="sobretitulo fila-mod">
						<span class="ico-leccion"><Icono nombre={leccion.icono} tamano={20} /></span>
						Módulo {modulo.numero} · {modulo.titulo}
					</p>
					<h1>{leccion.titulo}</h1>
					<p class="dur"><Icono nombre="clock" tamano={16} /> {d.minutos} min</p>
				</div>

				<p class="tema">{d.duda.tema}</p>

				{d.duda.cita && (
					<figure class="cita">
						<blockquote>“{d.duda.cita.texto}”</blockquote>
						<figcaption>{d.duda.cita.quien}</figcaption>
					</figure>
				)}

				<div class="duda">
					<p class="duda-etq"><Icono nombre="question" tamano={20} /> La duda que vas a resolver</p>
					<p class="duda-preg">{d.duda.pregunta}</p>
				</div>

				{d.duda.cifra && (
					<div class="no-solo">
						<p class="no-solo-tit">No eres la única persona con esta duda</p>
						<div class="personas" aria-hidden="true">
							{Array.from({ length: d.duda.cifra.de }, (_, i) => (
								<span class:list={{ si: i < d.duda.cifra!.n }}><Icono nombre="user-fill" tamano={22} /></span>
							))}
						</div>
						<p class="no-solo-dato">{d.duda.cifra.texto}</p>
						<p class="dato-fuente">Entrevistas del equipo a 25 jóvenes de 15 a 18 años, noviembre de 2026</p>
					</div>
				)}
			</section>

			<div class="contenido">
				<Content />
			</div>

			<section class="pantalla pantalla--final" data-pantalla data-final>
				<div class="mini-avance solo-js" data-mini-avance hidden>
					<Icono nombre="chart-line-up" tamano={22} />
					<p><span data-mini-txt></span> <a href={`${base}resultados/`}>Ver tus resultados</a></p>
				</div>
				<div class="en-corto">
					<p class="ec-tit"><Icono nombre="list-checks" tamano={22} /> En corto</p>
					<ul>
						{d.resumen.map((r) => <li><Icono nombre="check" tamano={16} /><span>{r}</span></li>)}
					</ul>
				</div>
				<div class="hoy">
					<p class="hoy-tit"><Icono nombre="calendar-check" tamano={22} /> Hoy</p>
					<p class="hoy-accion">{d.accion}</p>
				</div>

				<div class="sirvio solo-js" data-sirvio>
					<p class="sirvio-tit" id="sirvio-t">¿Te sirvió?</p>
					<div class="sirvio-op" role="group" aria-labelledby="sirvio-t">
						<button type="button" data-valor="si" aria-pressed="false">Sí</button>
						<button type="button" data-valor="masomenos" aria-pressed="false">Más o menos</button>
						<button type="button" data-valor="no" aria-pressed="false">No</button>
					</div>
					<p class="sirvio-msg" role="status" aria-live="polite"></p>
				</div>

				<nav class="botones" aria-label="¿A dónde sigues?">
					{siguiente ? (
						<a class="boton boton--morado boton--ancho siguiente" href={`${base}${siguiente.modulo}/${siguiente.slug}/`}>
							<span class="sig-txt">
								<span class="sig-etq">{otroModulo ? 'Siguiente módulo' : 'Siguiente lección'}</span>
								<span>{siguiente.titulo}</span>
							</span>
							<Icono nombre="arrow-right" tamano={22} />
						</a>
					) : (
						<a class="boton boton--morado boton--ancho" href={`${base}resultados/`}>
							<Icono nombre="chart-line-up" tamano={20} /> Ver cuánto aprendiste
						</a>
					)}
					<a class="boton boton--borde boton--ancho" href={urlModulo}>
						<Icono nombre="arrow-u-up-left" tamano={20} /> Volver al módulo {modulo.numero}
					</a>
					<a class="practica" href={`${base}practica/`}>
						<span class="pr-ico"><Icono nombre="game-controller" tamano={22} /></span>
						<span class="pr-txt">
							<span class="pr-tit">Practica con un juego</span>
							<span class="pr-sub">¿Mito o realidad? y más, en 1 minuto</span>
						</span>
						<Icono nombre="arrow-right" tamano={20} />
					</a>
					<a class="link-inicio" href={base}>
						<Icono nombre="house" tamano={18} /> Ir al inicio
					</a>
					{siguiente && (
						<a class="link-inicio" href={`${base}resultados/`}>
							<Icono nombre="chart-line-up" tamano={18} /> Ver cuánto has aprendido
						</a>
					)}
				</nav>

				<div class="compartir">
					<p class="compartir-tit"><Icono nombre="share-network" tamano={20} /> ¿Conoces a alguien que lo necesite?</p>
					<p class="compartir-txt">Mándale esta lección. Se abre directo, sin registrarse.</p>
					<a class="boton boton--borde boton--ancho" href={whatsapp} target="_blank" rel="noopener">
						<Icono nombre="whatsapp-logo" tamano={20} /> Mandar por WhatsApp
					</a>
				</div>

				<details class="fuentes">
					<summary>Fuentes de esta lección</summary>
					<ul>
						{d.fuentes.map((f) => <li><a href={f.url} target="_blank" rel="noopener">{f.nombre}</a></li>)}
					</ul>
				</details>

				<p class="aviso">Contenido educativo. No es asesoría financiera.</p>
			</section>
		</div>

		<nav class="barra-inf solo-js" data-navegacion aria-label="Avanzar en la lección">
			<button type="button" class="atras" data-atras aria-label="Pantalla anterior">
				<Icono nombre="arrow-left" tamano={22} />
			</button>
			<button type="button" class="boton boton--ancho" data-continuar>Continuar</button>
		</nav>
	</article>
</Base>

<script>
	import { terminar, marcarSirvio, leer } from '../../lib/progreso';

	const leccion = document.querySelector<HTMLElement>('[data-leccion]')!;
	const numero = leccion.dataset.leccion!;

	// Las líneas `---` del texto separan las pantallas. Aquí se agrupa cada parte en su <section>.
	const contenido = leccion.querySelector<HTMLElement>('.contenido')!;
	const grupos: Node[][] = [[]];
	[...contenido.childNodes].forEach((n) => {
		if (n instanceof HTMLHRElement) grupos.push([]);
		else grupos[grupos.length - 1].push(n);
	});
	contenido.replaceChildren(
		...grupos
			.filter((g) => g.some((n) => n.nodeType === 1 || n.textContent!.trim()))
			.map((g) => {
				const s = document.createElement('section');
				s.className = 'pantalla';
				s.dataset.pantalla = '';
				s.append(...g);
				return s;
			}),
	);
	const pantallas = [...leccion.querySelectorAll<HTMLElement>('[data-pantalla]')];
	const pasos = leccion.querySelector<HTMLElement>('[data-pasos]')!;
	const nav = leccion.querySelector<HTMLElement>('[data-navegacion]')!;
	const continuar = leccion.querySelector<HTMLButtonElement>('[data-continuar]')!;
	const atras = leccion.querySelector<HTMLButtonElement>('[data-atras]')!;
	let actual = 0;

	pasos.innerHTML = pantallas.map(() => '<span></span>').join('');
	leccion.classList.add('por-pasos');
	pantallas.forEach((p) => p.setAttribute('tabindex', '-1'));

	function mostrar(i: number, enfocar = true) {
		actual = Math.max(0, Math.min(i, pantallas.length - 1));
		pantallas.forEach((p, j) => p.classList.toggle('activa', j === actual));
		[...pasos.children].forEach((s, j) => s.classList.toggle('lleno', j <= actual));
		const esFinal = actual === pantallas.length - 1;
		nav.classList.toggle('en-final', esFinal);
		atras.disabled = actual === 0;
		continuar.textContent = actual === pantallas.length - 2 ? 'Terminar' : 'Continuar';
		if (esFinal) terminar(numero);
		window.scrollTo({ top: 0 });
		if (enfocar) pantallas[actual].focus({ preventScroll: true });
	}

	// Portada: el título en grande ocupa la pantalla y luego sube a su lugar.
	const portada = leccion.querySelector<HTMLElement>('[data-portada]');
	const cabeza = leccion.querySelector<HTMLElement>('[data-cabeza]')!;
	const quieto = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	if (portada) {
		const cerrarPortada = () => {
			if (portada.dataset.saliendo) return;
			portada.dataset.saliendo = '1';
			portada.classList.add('sale');
			cabeza.classList.add('llega');
			setTimeout(() => portada.remove(), 750);
		};
		if (quieto) portada.remove();
		else {
			const t = setTimeout(cerrarPortada, 2100);
			portada.addEventListener('click', () => {
				clearTimeout(t);
				cerrarPortada();
			});
		}
	}

	// Comparación inmediata con la encuesta inicial (si la pregunta es del banco).
	const ej = leccion.querySelector<HTMLElement>('[data-ejercicio][data-diagnostico]');
	const mini = leccion.querySelector<HTMLElement>('[data-mini-avance]');
	if (ej && mini) {
		const actualizarMini = () => {
			const e = leer();
			const id = ej.dataset.diagnostico!;
			const antes = e.diagnostico?.respuestas[id];
			const ahora = e.respuestas?.[id];
			if (antes === undefined || !ahora) return;
			const correcta = Number(ej.dataset.correcta);
			const txtAntes = antes === -1 ? 'no sabías' : antes === correcta ? 'ya lo sabías' : 'fallaste';
			const repaso = e.repaso?.[id];
			mini.querySelector('[data-mini-txt]')!.textContent = ahora.bien
				? `Antes del curso ${txtAntes}. Ahora lo respondiste bien.`
				: repaso?.bien
					? `Antes del curso ${txtAntes}. Al repasar, lo respondiste bien.`
					: `Antes del curso ${txtAntes}. Repasa la explicación y vuelve a intentarlo.`;
			mini.hidden = false;
		};
		ej.addEventListener('respondido', actualizarMini);
		actualizarMini();
	}

	continuar.addEventListener('click', () => mostrar(actual + 1));
	atras.addEventListener('click', () => mostrar(actual - 1));
	mostrar(0, false);

	// ¿Te sirvió? (se guarda solo en este navegador)
	const caja = leccion.querySelector<HTMLElement>('[data-sirvio]')!;
	const msg = caja.querySelector('.sirvio-msg')!;
	const textos = {
		si: 'Qué bueno. Pásala a alguien que la necesite.',
		masomenos: 'Gracias. La vamos a mejorar.',
		no: 'Gracias por decirnos. La vamos a mejorar.',
	};
	const marcar = (v: keyof typeof textos) => {
		caja.querySelectorAll('button').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.valor === v)));
		msg.textContent = textos[v];
	};
	const previo = leer().sirvio[numero];
	if (previo) marcar(previo);
	caja.addEventListener('click', (e) => {
		const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-valor]');
		if (!b) return;
		const v = b.dataset.valor as keyof typeof textos;
		marcar(v);
		marcarSirvio(numero, v);
	});
</script>

<style>
	.leccion {
		min-height: 100dvh;
		display: flex;
		flex-direction: column;
	}
	.barra-sup {
		position: sticky;
		top: 0;
		z-index: 20;
		display: flex;
		align-items: center;
		gap: 0.75rem;
		height: var(--alto-barra);
		padding-inline: 0.5rem 1rem;
		background: rgb(255 255 255 / 0.94);
		backdrop-filter: blur(8px);
		border-bottom: 1px solid var(--linea);
	}
	.cerrar {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.75rem;
		height: 2.75rem;
		border-radius: 50%;
		color: var(--tinta);
	}
	.cerrar:hover {
		background: var(--fondo-2);
	}
	.pasos {
		flex: 1;
		display: flex;
		gap: 4px;
	}
	.pasos :global(span) {
		flex: 1;
		height: 4px;
		border-radius: 999px;
		background: var(--linea);
		transition: background 0.25s;
	}
	.pasos :global(span.lleno) {
		background: var(--morado);
	}
	.etiqueta {
		flex: 1;
		font-size: 0.875rem;
		color: var(--gris);
	}
	.num {
		font-size: 0.875rem;
		color: var(--gris);
	}

	.pantallas {
		flex: 1;
		padding-top: 2rem;
		padding-bottom: 7rem;
	}
	/* Sin JS: todas las pantallas seguidas, separadas por espacio. */
	.pantallas :global(.pantalla) {
		padding-bottom: 3rem;
	}
	.contenido,
	.pantalla--final {
		padding-top: 3rem;
		border-top: 1px solid var(--linea);
	}
	/* Con JS: una pantalla a la vez. */
	.por-pasos .contenido,
	.por-pasos .pantalla--final {
		padding-top: 0;
		border-top: 0;
	}
	.por-pasos .pantallas :global(.pantalla) {
		display: none;
		padding-top: 0;
		border-top: 0;
		outline: none;
	}
	.por-pasos .pantallas :global(.pantalla.activa) {
		display: block;
		animation: entrar 0.3s ease-out;
	}
	@keyframes entrar {
		from {
			opacity: 0;
			transform: translateY(8px);
		}
	}

	/* Pantalla 1: la duda */
	h1 {
		margin-top: 0.75rem;
		font-size: clamp(2rem, 9vw, 2.75rem);
		letter-spacing: -0.04em;
		line-height: 1.05;
	}
	.dur {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		margin-top: 1rem;
		font-size: 0.875rem;
		color: var(--gris);
	}
	.cabeza-leccion {
		padding-bottom: 1.25rem;
		border-bottom: 1px solid var(--linea);
	}
	.fila-mod {
		display: flex;
		align-items: center;
		gap: 0.6rem;
	}
	.ico-leccion {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.25rem;
		height: 2.25rem;
		border-radius: 0.75rem;
		background: var(--morado-claro);
		color: var(--morado);
	}
	.cabeza-leccion.llega {
		animation: llega 0.6s cubic-bezier(0.2, 0.7, 0.2, 1) both;
	}
	@keyframes llega {
		from {
			opacity: 0;
			transform: translateY(-2.5rem) scale(1.08);
			transform-origin: left top;
		}
	}
	.tema {
		margin-top: 1.25rem;
		font-size: 1.0625rem;
		line-height: 1.55;
		color: var(--tinta-2);
	}
	.cita {
		margin: 1.5rem 0 0;
		padding-left: 1.125rem;
		border-left: 3px solid var(--morado);
	}
	.cita blockquote {
		margin: 0;
		font-family: var(--f-display);
		font-size: clamp(1.625rem, 7vw, 2rem);
		font-style: italic;
		line-height: 1.15;
		letter-spacing: -0.01em;
		color: var(--tinta);
	}
	.cita figcaption {
		margin-top: 0.5rem;
		font-size: 0.875rem;
		color: var(--gris);
	}
	.duda {
		margin-top: 1.25rem;
		padding: 1.25rem;
		border-radius: var(--radio);
		background: var(--tinta);
		color: #fff;
	}
	.duda-etq {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		font-size: 0.875rem;
		font-weight: 600;
		color: #d8b8f5;
	}
	.duda-preg {
		margin-top: 0.5rem;
		font-family: var(--f-titulo);
		font-size: clamp(1.375rem, 6vw, 1.625rem);
		font-weight: 600;
		line-height: 1.25;
		letter-spacing: -0.025em;
	}
	.no-solo {
		margin-top: 1.5rem;
	}
	.no-solo-tit {
		font-family: var(--f-titulo);
		font-weight: 600;
		font-size: 1.0625rem;
	}
