---
/** Páginas de texto simples: Fuentes, Sobre el curso, 404. */
import Base from './Base.astro';
interface Props {
	titulo: string;
	descripcion: string;
	sobretitulo?: string;
}
const { titulo, descripcion, sobretitulo } = Astro.props;
---

<Base titulo={titulo} descripcion={descripcion}>
	<article class="contenedor texto">
		{sobretitulo && <p class="sobretitulo">{sobretitulo}</p>}
		<h1>{titulo}</h1>
		<slot />
	</article>
</Base>

<style>
	.texto {
		padding-top: clamp(2rem, 8vw, 4rem);
	}
	h1 {
		margin-top: 0.5rem;
		font-size: clamp(2rem, 8vw, 3rem);
		letter-spacing: -0.04em;
	}
	.texto :global(h2) {
		margin-top: 2.5rem;
		font-size: 1.375rem;
	}
	.texto :global(p),
	.texto :global(ul) {
		margin-top: 1rem;
		color: var(--tinta-2);
	}
	.texto :global(li + li) {
		margin-top: 0.5rem;
	}
</style>
