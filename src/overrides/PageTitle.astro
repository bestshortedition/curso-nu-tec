---
/**
 * Arriba de cada byte: tema + número + minutos, el título y la duda real
 * (cita de las entrevistas o dato). Es lo primero que se lee.
 */
// Mismo id que usa Starlight para el título (enlace "saltar al contenido").
const PAGE_TITLE_ID = '_top';
import Icono from '../components/Icono.astro';
import { temaPorClave } from '../lib/temas';

const { data } = Astro.locals.starlightRoute.entry;
const tema = temaPorClave(data.tema);
const esByte = data.tipo === 'byte';
const esTema = data.tipo === 'tema';
// En el inicio, lo primero que se ve es la cita; el título queda para lectores de pantalla.
const esInicio = Astro.locals.starlightRoute.id === '' || Astro.locals.starlightRoute.entry.id === 'index';
---

{(esByte || esTema) && tema && (
	<p class="etiqueta arriba">
		<Icono nombre={tema.icono} tamano={18} />
		<span>Tema {tema.numero}</span>
		{esByte && <><span aria-hidden="true">·</span><span>Byte {data.numero}</span></>}
		{esByte && <><span aria-hidden="true">·</span><span>{data.minutos} min</span></>}
	</p>
)}

<h1 id={PAGE_TITLE_ID} class:list={{ 'sr-only': esInicio }}>{data.title}</h1>

{esByte && data.duda && (
	<figure class:list={['duda', `duda--${data.duda.clase}`]}>
		{data.duda.clase === 'cita' ? (
			<blockquote>
				<p>“{data.duda.texto}”</p>
			</blockquote>
		) : (
			<p class="dato">{data.duda.texto}</p>
		)}
		<figcaption>{data.duda.quien}</figcaption>
	</figure>
)}

<style>
	.arriba {
		margin-top: 1rem;
		color: var(--nu-morado);
	}
	h1 {
		margin-top: 0.5rem;
		font-size: clamp(1.75rem, 6vw, 2.5rem);
		line-height: 1.15;
		font-weight: 700;
		color: var(--nu-texto);
	}
	.duda {
		margin: 1.5rem 0 0;
		padding: 1.25rem 1.25rem 1rem;
		background: var(--nu-lila);
		border-radius: 1.25rem 1.25rem 1.25rem 0.25rem;
	}
	.duda blockquote {
		margin: 0;
		padding: 0;
		border: 0;
	}
	.duda blockquote p,
	.dato {
		margin: 0;
		font-size: 1.25rem;
		line-height: 1.4;
		font-weight: 600;
		color: var(--nu-texto);
	}
	.duda figcaption {
		margin-top: 0.75rem;
		font-size: 0.9375rem;
		color: var(--nu-gris);
	}
	.duda figcaption::before {
		content: '— ';
	}
	.duda--dato {
		background: #ffffff;
		border: 2px solid var(--nu-lila-borde);
		border-radius: 1rem;
	}
	.duda--dato figcaption::before {
		content: '';
	}
</style>
