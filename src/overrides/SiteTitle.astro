---
// Encabezado: identidad "Nu × Tec" + nombre del curso.
import { Image } from 'astro:assets';
import logoNu from '../assets/nu_purple.png';
const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="marca">
	<Image src={logoNu} alt="Nu" width={44} densities={[1, 2]} class="logo" loading="eager" />
	<span class="x" aria-hidden="true">×</span>
	<span class="tec">Tec</span>
	<span class="separador" aria-hidden="true"></span>
	<span class="curso" translate="no">{siteTitle}</span>
</a>

<style>
	.marca {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		text-decoration: none;
		color: var(--nu-texto);
		min-height: 2.75rem;
	}
	.logo {
		height: auto;
		width: 44px;
	}
	.x {
		color: var(--nu-gris);
		font-size: 1rem;
	}
	.tec {
		font-weight: 700;
		font-size: 1rem;
		letter-spacing: -0.01em;
	}
	.separador {
		width: 1px;
		height: 1.25rem;
		background: var(--nu-linea);
		margin-inline: 0.25rem;
	}
	.curso {
		font-weight: 600;
		font-size: 1rem;
		white-space: nowrap;
	}
	@media (max-width: 22rem) {
		.separador,
		.curso {
			display: none;
		}
	}
</style>
