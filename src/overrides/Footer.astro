---
/**
 * Abajo de cada byte: la acción de hoy → ¿te sirvió? → mandar por WhatsApp
 * → siguiente byte → fuentes. En todas las páginas: el aviso legal.
 */
import Icono from '../components/Icono.astro';
import { temaPorClave } from '../lib/temas';

const route = Astro.locals.starlightRoute;
const { data, id } = route.entry;
const esByte = data.tipo === 'byte';
const tema = temaPorClave(data.tema);
const siguiente = route.pagination.next;
const base = import.meta.env.BASE_URL;

const urlPublica = new URL(Astro.url.pathname, Astro.site).href;
const textoWhatsapp = `${data.title}\n${data.description ?? ''}\n${urlPublica}`;
const enlaceWhatsapp = `https://wa.me/?text=${encodeURIComponent(textoWhatsapp)}`;
---

<footer class="pie">
	{esByte && (
		<>
			<section class="hoy" aria-labelledby="hoy-titulo">
				<h2 id="hoy-titulo" class="hoy-titulo">
					<Icono nombre="calendar-days" tamano={22} /> Hoy
				</h2>
				<p>{data.accion}</p>
			</section>

			<section class="sirvio solo-js" data-sirvio={id} aria-labelledby="sirvio-titulo">
				<h2 id="sirvio-titulo" class="pregunta">¿Te sirvió?</h2>
				<div class="opciones" role="group" aria-labelledby="sirvio-titulo">
					<button type="button" class="boton boton--claro" data-valor="si">Sí</button>
					<button type="button" class="boton boton--claro" data-valor="masomenos">Más o menos</button>
					<button type="button" class="boton boton--claro" data-valor="no">No</button>
				</div>
				<p class="gracias" role="status" aria-live="polite"></p>
			</section>

			<div class="acciones">
				<a class="boton boton--claro" href={enlaceWhatsapp} target="_blank" rel="noopener">
					<Icono nombre="message-circle" tamano={20} /> Mandar por WhatsApp
				</a>
				{siguiente && (
					<a class="boton siguiente" href={siguiente.href}>
						<span>
							<span class="sig-label">Siguiente</span>
							<span class="sig-titulo">{siguiente.label}</span>
						</span>
						<Icono nombre="arrow-right" tamano={22} />
					</a>
				)}
			</div>

			{data.fuentes && data.fuentes.length > 0 && (
				<section class="fuentes" aria-labelledby="fuentes-titulo">
					<h2 id="fuentes-titulo">Fuentes</h2>
					<ul>
						{data.fuentes.map((f) => (
							<li><a href={f.url} target="_blank" rel="noopener">{f.nombre}</a></li>
						))}
					</ul>
				</section>
			)}
		</>
	)}

	{!esByte && data.tipo === 'tema' && siguiente && (
		<div class="acciones">
			<a class="boton siguiente" href={siguiente.href}>
				<span>
					<span class="sig-label">Empezar</span>
					<span class="sig-titulo">{siguiente.label}</span>
				</span>
				<Icono nombre="arrow-right" tamano={22} />
			</a>
		</div>
	)}

	<div class="aviso">
		<p><strong>Contenido educativo. No es asesoría financiera.</strong></p>
		<p>
			Los datos técnicos vienen de Banxico y CONDUSEF (ver <a href={`${base}fuentes/`}>fuentes</a>).
			Este sitio no pide ni guarda datos personales.{' '}
			<a href={`${base}sobre-el-curso/`}>Sobre el curso</a>.
		</p>
		<p class="creditos">Nu × Tecnológico de Monterrey · Reto de Educación Financiera, 2026</p>
	</div>
</footer>

{esByte && (
	<script is:inline data-byte={id} data-tema={tema?.clave}>
		(function () {
			var actual = document.currentScript;
			var byte = actual.dataset.byte;
			// Progreso: se guarda solo en este navegador. Sin cuentas ni datos personales.
			try {
				var p = JSON.parse(localStorage.getItem('bytes-progreso') || '{}');
				p[byte] = true;
				localStorage.setItem('bytes-progreso', JSON.stringify(p));
			} catch (e) {}

			var caja = document.querySelector('[data-sirvio]');
			if (!caja) return;
			var gracias = caja.querySelector('.gracias');
			var clave = 'bytes-sirvio';
			var mensajes = {
				si: '¡Qué bueno! Pásalo a alguien que lo necesite.',
				masomenos: 'Gracias. Lo vamos a mejorar.',
				no: 'Gracias por decirnos. Lo vamos a mejorar.',
			};
			function marcar(valor) {
				caja.querySelectorAll('button').forEach(function (b) {
					b.setAttribute('aria-pressed', String(b.dataset.valor === valor));
				});
				gracias.textContent = mensajes[valor] || '';
			}
			try {
				var previo = JSON.parse(localStorage.getItem(clave) || '{}')[byte];
				if (previo) marcar(previo);
			} catch (e) {}
			caja.addEventListener('click', function (ev) {
				var b = ev.target.closest('button[data-valor]');
				if (!b) return;
				marcar(b.dataset.valor);
				try {
					var r = JSON.parse(localStorage.getItem(clave) || '{}');
					r[byte] = b.dataset.valor;
					localStorage.setItem(clave, JSON.stringify(r));
				} catch (e) {}
			});
		})();
	</script>
)}

<style>
	.pie {
		display: flex;
		flex-direction: column;
		gap: 1.75rem;
		margin-top: 2rem;
	}
	.pie h2 {
		margin: 0;
	}
	.hoy {
		padding: 1.25rem;
		border-left: 6px solid var(--nu-morado);
		background: #ffffff;
		box-shadow: 0 0 0 1px var(--nu-linea);
		border-radius: 0 1rem 1rem 0;
	}
	.hoy-titulo {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 1.125rem;
		color: var(--nu-morado);
	}
	.hoy p {
		margin: 0.5rem 0 0;
		font-size: 1.125rem;
		font-weight: 600;
		color: var(--nu-texto);
	}
	.pregunta {
		font-size: 1.125rem;
	}
	.opciones {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-top: 0.75rem;
	}
	.opciones .boton {
		min-width: 5.5rem;
	}
	.opciones .boton[aria-pressed='true'] {
		background: var(--nu-morado);
		color: #ffffff;
	}
	.gracias {
		margin: 0.75rem 0 0;
		color: var(--nu-gris);
		min-height: 1.5em;
	}
	.acciones {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}
	.siguiente {
		justify-content: space-between;
		text-align: start;
		border-radius: 1rem;
		padding: 0.875rem 1.25rem;
	}
	.sig-label {
		display: block;
		font-size: 0.8125rem;
		font-weight: 500;
		opacity: 0.85;
	}
	.sig-titulo {
		display: block;
		font-size: 1.0625rem;
	}
	.fuentes h2 {
		font-size: 1rem;
		color: var(--nu-gris);
	}
	.fuentes ul {
		margin: 0.5rem 0 0;
		padding-left: 1.1rem;
		font-size: 0.9375rem;
	}
	.fuentes li + li {
		margin-top: 0.35rem;
	}
	.fuentes a,
	.aviso a {
		color: var(--nu-morado);
	}
	.aviso {
		margin-top: 1rem;
		padding-top: 1.25rem;
		border-top: 1px solid var(--nu-linea);
		font-size: 0.9375rem;
		color: var(--nu-gris);
	}
	.aviso p {
		margin: 0 0 0.5rem;
	}
	.aviso strong {
		color: var(--nu-texto);
	}
	.creditos {
		font-size: 0.875rem;
	}
	@media (min-width: 40rem) {
		.acciones {
			flex-direction: row-reverse;
			justify-content: space-between;
			align-items: stretch;
		}
	}
</style>
